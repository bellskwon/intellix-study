{
  "experimentalServices": {
    "frontend": {
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend",
      "routePrefix": "/_backend",
      "buildCommand": "npm install && npx prisma generate"
    }
  },
  "rewrites": [
    {
      "source": "/((?!_backend|assets|favicon).*)",
      "destination": "/index.html"
    }
  ]
}
